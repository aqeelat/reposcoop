{
  "name": "reposcoop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "test:unit": "vitest run",
    "test": "bun run test:unit",
    "test:ci": "bun run test:unit --coverage --reporter=junit --output-file=junit-unit-tests.xml"
  },
  "lint-staged": {
    "*.{js,ts,svelte,json,md,html}": [
      "bun lint:fix"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/semver": "^7.7.1",
    "@vitest/browser": "^4.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.0",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.0",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.0.0",
    "vitest-browser-svelte": "^3.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.0",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.6.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
